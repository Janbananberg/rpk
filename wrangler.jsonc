// Cloudflare Workers: the built Vite app from dist/, with the backend in worker/ on /api/*.
// Unknown paths (/turnering, /storbild …) get index.html so React Router can take over.
{
  "name": "rpk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only the API runs the worker; every other request is served straight from dist/.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rpk",
      "database_id": "8904a5ea-e5c8-421f-ac83-81ed71b6cb9d"
    }
  ],
  "observability": { "enabled": true }
}
